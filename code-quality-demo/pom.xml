<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>de.thb</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>code-quality-demo</name>
	<description>Demo VL4 CCDO: Code Quality mit JaCoCo, Checkstyle, PMD, SpotBugs und SonarQube Cloud</description>

	<properties>
		<!-- Spring Boot setzt daraus maven.compiler.release -->
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!--
			SonarQube Cloud (ehemals SonarCloud)
			Platzhalter: an deine Organisation und deinen Projektschlüssel anpassen.
			Beides steht in SonarQube Cloud unter "Information" des Projekts.
		-->
		<sonar.organization>lars-gentsch-thb</sonar.organization>
		<sonar.projectKey>lars-gentsch-thb_ccdo-vl4-code-quality</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>

		<!-- Plugin-Versionen (surefire, failsafe, compiler verwaltet Spring Boot) -->
		<jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<!-- Checkstyle 13.3+ braucht Java 21 zur Laufzeit -->
		<checkstyle.version>14.4.0</checkstyle.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<pmd.version>7.29.0</pmd.version>
		<spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
		<maven-jxr-plugin.version>3.6.0</maven-jxr-plugin.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
		<jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>

		<!-- Ziel-Image für Jib (in der CI per -Djib.to.image überschrieben) -->
		<jib.image>ghcr.io/lars-gentsch-thb/ccdo-vl4-code-quality</jib.image>

		<!--
			Security-Overrides (Trivy-Quality-Gate im Container-Workflow, 11/2026):
			Spring Boot 3.5.16 ist das letzte OSS-Release der 3.5-Linie (OSS-Support
			endete 06/2026), bringt aber verwundbare Versionen mit:
			  - Tomcat 10.1.55: u.a. CVE-2026-55276, CVE-2026-53404, CVE-2026-65905,
			    CVE-2026-65182, CVE-2026-68525, CVE-2026-65637 (Fix ab 10.1.59)
			  - Jackson 2.21.4: CVE-2026-68497, CVE-2026-91776, CVE-2026-91777 (databind),
			    CVE-2026-89407, CVE-2026-89425 (core) (Fix ab 2.21.7)
			Patch-Versionen derselben Minor-Linie ueberschreiben die Boot-Vorgaben.
			Wieder entfernen, sobald auf Spring Boot 4.x migriert ist.
		-->
		<tomcat.version>10.1.62</tomcat.version>
		<jackson-bom.version>2.21.8</jackson-bom.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<!-- erlaubt den Kurzaufruf ./mvnw sonar:sonar -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
				<!-- PMD: Version des Plugins und der PMD-Engine (gilt für Build und Reporting) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<dependencies>
						<!-- PMD-Version unabhängig vom Plugin aktualisieren -->
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-core</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-java</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-javascript</artifactId>
							<version>${pmd.version}</version>
						</dependency>
						<dependency>
							<groupId>net.sourceforge.pmd</groupId>
							<artifactId>pmd-jsp</artifactId>
							<version>${pmd.version}</version>
						</dependency>
					</dependencies>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Unit-Tests: Klassen mit Endung *Tests -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Tests.*</include>
					</includes>
				</configuration>
			</plugin>

			<!-- Integrationstests: Klassen mit Endung *IT -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.*</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- JaCoCo: Testabdeckung messen, Report erzeugen, Mindestabdeckung prüfen -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>default-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>default-prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>default-report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>default-report-integration</id>
						<goals>
							<goal>report-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>default-check</id>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<!-- Quality Gate: mindestens 60 % der Komplexität (Zweige) abgedeckt -->
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>COMPLEXITY</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.60</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Checkstyle: Google Java Style, meldet nur Warnungen (bricht den Build nicht ab) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven-checkstyle-plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<consoleOutput>true</consoleOutput>
					<failsOnError>false</failsOnError>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<id>validate</id>
						<phase>validate</phase>
						<goals>
							<goal>checkstyle</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- PMD 7: bricht den Build bei Regelverstößen ab (Goal check in der Phase verify) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<configuration>
					<targetJdk>${java.version}</targetJdk>
					<failOnViolation>true</failOnViolation>
					<printFailingErrors>true</printFailingErrors>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- SpotBugs (optional): sucht typische Bug-Muster im Bytecode, meldet nur -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-maven-plugin.version}</version>
				<configuration>
					<!-- auf true setzen, damit gefundene Bugs den Build abbrechen -->
					<failOnError>false</failOnError>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Jib: Container-Image ohne Dockerfile und ohne Docker-Daemon bauen -->
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<version>${jib-maven-plugin.version}</version>
				<configuration>
					<from>
						<image>eclipse-temurin:21-jre</image>
					</from>
					<to>
						<image>${jib.image}</image>
						<tags>
							<tag>latest</tag>
						</tags>
					</to>
					<container>
						<ports>
							<port>8080</port>
						</ports>
						<creationTime>USE_CURRENT_TIMESTAMP</creationTime>
					</container>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- ./mvnw site: HTML-Reports für PMD mit verlinktem Quelltext (JXR) -->
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jxr-plugin</artifactId>
				<version>${maven-jxr-plugin.version}</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<configuration>
					<linkXRef>true</linkXRef>
				</configuration>
			</plugin>
		</plugins>
	</reporting>

</project>
